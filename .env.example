# Copy this file to .env and fill in your values.
# Never commit your actual .env file with real credentials.

# SurveyMonkey OAuth access token
SURVEYMONKEY_TOKEN=your_access_token_here

# Base URL for the SurveyMonkey v3 API (rarely needs changing)
SURVEYMONKEY_BASE_URL=https://api.surveymonkey.com/v3

# Default output directory for generated Excel files
OUTPUT_DIR=./output
